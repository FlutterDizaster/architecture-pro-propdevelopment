;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat1d2" target="cat1d2r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat1d2r1" target="cat1d2w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat1d3" value="Информация о компании и жилых комплексах: описания, новости, акции" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-670" y="-288" width="250" height="62" as="geometry" /></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat1" target="cat1d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="-373.0" /><mxPoint x="-390.0" y="-257.0" /></Array></mxGeometry></mxCell><mxCell id="cat1d3r1" value="Обесценивание: незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-930" y="-288" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat1d3w1" value="Новости и акции быстро устаревают. Клиент увидит неактуальное предложение, ущерб ограничится лишним звонком менеджеру." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="-288" width="430" height="62" as="geometry" /></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat1d3" target="cat1d3r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat1d3r1" target="cat1d3w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2" value="Конфиденциальные данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="-360" y="147" width="170" height="60" as="geometry" /></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="center" target="cat2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-150.0" y="0.0" /><mxPoint x="-150.0" y="177.0" /></Array></mxGeometry></mxCell><mxCell id="cat2d1" value="Контакты клиентов в client-crm-app: ФИО, телефон, почта" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-670" y="-130" width="250" height="46" as="geometry" /></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2" target="cat2d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="177.0" /><mxPoint x="-390.0" y="-107.0" /></Array></mxGeometry></mxCell><mxCell id="cat2d1r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="-930" y="-166" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d1w1" value="Это персональные данные по 152-ФЗ. Клиенты уже видят в личном кабинете чужое ФИО. Дальше штрафы и огласка, как у конкурента." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="-166" width="430" height="62" as="geometry" /></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d1" target="cat2d1r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-700.0" y="-107.0" /><mxPoint x="-700.0" y="-135.0" /></Array></mxGeometry></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d1r1" target="cat2d1w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2d1r2" value="Некачественные данные: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-930" y="-94" width="200" height="46" as="geometry" /></mxCell><mxCell id="cat2d1w2" value="Несколько точек регистрации дают дубли и расхождения в профилях. Отсюда же ошибки в личном кабинете и жалобы." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="-94" width="430" height="46" as="geometry" /></mxCell><mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d1" target="cat2d1r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-700.0" y="-107.0" /><mxPoint x="-700.0" y="-71.0" /></Array></mxGeometry></mxCell><mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d1r2" target="cat2d1w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2d2" value="Расширенная анкета и документы онлайн-сделки: паспортные данные, договоры" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-670" y="14" width="250" height="62" as="geometry" /></mxCell><mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2" target="cat2d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="177.0" /><mxPoint x="-390.0" y="45.0" /></Array></mxGeometry></mxCell><mxCell id="cat2d2r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="-930" y="-22" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d2w1" value="Полный набор данных о человеке и его покупке. По 152-ФЗ это крупный штраф, а для клиента риск мошенничества с его документами." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="-22" width="430" height="62" as="geometry" /></mxCell><mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d2" target="cat2d2r1">