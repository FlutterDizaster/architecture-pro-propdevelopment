<mxfile host="app.diagrams.net"><diagram name="Безопасность данных" id="mindmap"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="center" value="Безопасность данных" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontSize=16;fontStyle=1;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="-110" y="-40" width="220" height="80" as="geometry" /></mxCell><mxCell id="cat1" value="Публичные данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="-360" y="-403" width="170" height="60" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="center" target="cat1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-150.0" y="0.0" /><mxPoint x="-150.0" y="-373.0" /></Array></mxGeometry></mxCell><mxCell id="cat1d1" value="Каталог недвижимости на витрине: объекты, цены, планировки" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-670" y="-476" width="250" height="46" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat1" target="cat1d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="-373.0" /><mxPoint x="-390.0" y="-453.0" /></Array></mxGeometry></mxCell><mxCell id="cat1d1r1" value="Искажение: значительный" style="rounded=1;whiteSpace