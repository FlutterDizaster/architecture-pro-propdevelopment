y="182" width="250" height="46" as="geometry" /></mxCell><mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2" target="cat2d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="177.0" /><mxPoint x="-390.0" y="205.0" /></Array></mxGeometry></mxCell><mxCell id="cat2d3r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="-930" y="138" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d3w1" value="Контракты API управляющих компаний отдают персональные данные, партнёр видит клиентов чужой УК. Утечка уже возможна штатными средствами." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="138" width="430" height="62" as="geometry" /></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d3" target="cat2d3r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-700.0" y="205.0" /><mxPoint x="-700.0" y="169.0" /></Array></mxGeometry></mxCell><mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d3r1" target="cat2d3w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2d3r2" value="Искажение: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-930" y="210" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d3w2" value="Тот же API позволяет партнёру менять данные чужих клиентов. Начисления и уведомления уйдут не тому собственнику." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="210" width="430" height="62" as="geometry" /></mxCell><mxCell id="e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d3" target="cat2d3r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-700.0" y="205.0" /><mxPoint x="-700.0" y="241.0" /></Array></mxGeometry></mxCell><mxCell id="e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d3r2" target="cat2d3w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2d4" value="Финансовый учёт в accountant-service-1: проводки, взаиморасчёты, отчётность" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-670" y="334" width="250" height="62" as="geometry" /></mxCell><mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2" target="cat2d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="177.0" /><mxPoint x="-390.0" y="365.0" /></Array></mxGeometry></mxCell><mxCell id="cat2d4r1" value="Искажение: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="-930" y="298" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d4w1" value="По этим данным компания платит налоги и рассчитывается с партнёрами. Незаметная правка обернётся прямыми убытками и претензиями налоговой." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="298" width="430" height="62" as="geometry" /></mxCell><mxCell id="e30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d4" target="cat2d4r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-700.0" y="365.0" /><mxPoint x="-700.0" y="329.0" /></Array></mxGeometry></mxCell><mxCell id="e31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d4r1" target="cat2d4w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2d4r2" value="Потеря: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-930" y="370" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d4w2" value="Копии базы делаются, поэтому всё не пропадёт. Но операции после последней копии придётся восстанавливать вручную, учёт на это время встанет." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="370" width="430" height="62" as="geometry" /></mxCell><mxCell id="e32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d4" target="cat2d4r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-700.0" y="365.0" /><mxPoint x="-700.0" y="401.0" /></Array></mxGeometry></mxCell><mxCell id="e33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d4r2" target="cat2d4w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat2d5" value="Сырые данные в хранилище DWH: копии всех баз компании" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-670" y="466" width="250" height="46" as="geometry" /></mxCell><mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2" target="cat2d5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-390.0" y="177.0" /><mxPoint x="-390.0" y="489.0" /></Array></mxGeometry></mxCell><mxCell id="cat2d5r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="-930" y="458" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat2d5w1" value="В одном месте собраны необезличенные данные клиентов, собственников и сделок, а доступ систем обработки данных ничем не ограничен." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="-1420" y="458" width="430" height="62" as="geometry" /></mxCell><mxCell id="e35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d5" target="cat2d5r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat2d5r1" target="cat2d5w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat3" value="Внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="-295" width="170" height="60" as="geometry" /></mxCell><mxCell id="e37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="center" target="cat3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150.0" y="0.0" /><mxPoint x="150.0" y="-265.0" /></Array></mxGeometry></mxCell><mxCell id="cat3d1" value="Бронирования и результаты осмотров: объект, статус, итог тура" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="-464" width="250" height="62" as="geometry" /></mxCell><mxCell id="e38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3" target="cat3d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="-265.0" /><mxPoint x="390.0" y="-433.0" /></Array></mxGeometry></mxCell><mxCell id="cat3d1r1" value="Некачественные данные: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="-500" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat3d1w1" value="Клиента регистрируют в нескольких точках без координации. Появляются дубли, бронь и осмотр привязываются не к тому профилю." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="-500" width="430" height="62" as="geometry" /></mxCell><mxCell id="e39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d1" target="cat3d1r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="-433.0" /><mxPoint x="700.0" y="-469.0" /></Array></mxGeometry></mxCell><mxCell id="e40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d1r1" target="cat3d1w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat3d1r2" value="Потеря: незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="730" y="-428" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat3d1w2" value="Резервные копии есть на нужную глубину. Потеряются только последние брони, менеджер восстановит их по переписке с клиентом." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="-428" width="430" height="62" as="geometry" /></mxCell><mxCell id="e41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d1" target="cat3d1r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="-433.0" /><mxPoint x="700.0" y="-397.0" /></Array></mxGeometry></mxCell><mxCell id="e42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d1r2" target="cat3d1w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat3d2" value="Данные о доме от управляющих компаний: графики и история ремонтов, объявления" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="-340" width="250" height="62" as="geometry" /></mxCell><mxCell id="e43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3" target="cat3d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="-265.0" /><mxPoint x="390.0" y="-309.0" /></Array></mxGeometry></mxCell><mxCell id="cat3d2r1" value="Искажение: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="-340" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat3d2w1" value="API управляющих компаний работают без единых политик. Партнёр одной УК может изменить данные жилого комплекса другой, жильцы получат неверную информацию." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="-340" width="430" height="62" as="geometry" /></mxCell><mxCell id="e44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d2" target="cat3d2r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d2r1" target="cat3d2w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat3d3" value="Отчёты BI и витрины хранилища" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="-200" width="250" height="30" as="geometry" /></mxCell><mxCell id="e46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3" target="cat3d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="-265.0" /><mxPoint x="390.0" y="-185.0" /></Array></mxGeometry></mxCell><mxCell id="cat3d3r1" value="Некачественные данные: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="-252" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat3d3w1" value="Сырые данные льются в хранилище из всех баз без контроля потоков, клиенты задвоены. Отчётам нельзя доверять, решения принимаются на кривых цифрах." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="-252" width="430" height="62" as="geometry" /></mxCell><mxCell id="e47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d3" target="cat3d3r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="-185.0" /><mxPoint x="700.0" y="-221.0" /></Array></mxGeometry></mxCell><mxCell id="e48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d3r1" target="cat3d3w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat3d3r2" value="Обесценивание: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="-180" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat3d3w2" value="Данные копятся, но не работают. Пока нет управления потоками, сервисы на BI и ML запустить нельзя, накопленное теряет ценность." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="-180" width="430" height="62" as="geometry" /></mxCell><mxCell id="e49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d3" target="cat3d3r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="-185.0" /><mxPoint x="700.0" y="-149.0" /></Array></mxGeometry></mxCell><mxCell id="e50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d3r2" target="cat3d3w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat3d4" value="Технические данные: логи, конфигурации, схемы интеграций" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="-84" width="250" height="46" as="geometry" /></mxCell><mxCell id="e51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3" target="cat3d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="-265.0" /><mxPoint x="390.0" y="-61.0" /></Array></mxGeometry></mxCell><mxCell id="cat3d4r1" value="Утечка: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="-92" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat3d4w1" value="Сами по себе не секрет, но облегчают атаку. Часть систем стоит в арендованном облаке, а специалист по ИБ один и узнаёт не обо всех изменениях." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="-92" width="430" height="62" as="geometry" /></mxCell><mxCell id="e52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d4" target="cat3d4r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat3d4r1" target="cat3d4w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat4" value="Секретные данные" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="190" y="235" width="170" height="60" as="geometry" /></mxCell><mxCell id="e54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="center" target="cat4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150.0" y="0.0" /><mxPoint x="150.0" y="265.0" /></Array></mxGeometry></mxCell><mxCell id="cat4d1" value="Платёжные данные при оплате ЖКУ: данные платежей и карт на пути в платёжную систему" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="38" width="250" height="62" as="geometry" /></mxCell><mxCell id="e55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4" target="cat4d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="265.0" /><mxPoint x="390.0" y="69.0" /></Array></mxGeometry></mxCell><mxCell id="cat4d1r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="30" width="200" height="78" as="geometry" /></mxCell><mxCell id="cat4d1w1" value="Прямые денежные потери собственников и ответственность компании. Оплата идёт из tenant-core-app во внешнюю платёжную систему, а что именно при этом остаётся в наших базах и журналах, никто системно не контролирует." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="30" width="430" height="78" as="geometry" /></mxCell><mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d1" target="cat4d1r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d1r1" target="cat4d1w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat4d2" value="Учётные записи и пароли: клиенты в auth-service-1, сотрудники в Active Directory" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="250" height="62" as="geometry" /></mxCell><mxCell id="e58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4" target="cat4d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="265.0" /><mxPoint x="390.0" y="201.0" /></Array></mxGeometry></mxCell><mxCell id="cat4d2r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="134" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat4d2w1" value="Чужая учётка открывает личный кабинет или внутренние системы целиком. Ограничений доступа к данным мало, поэтому украсть можно почти всё." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="134" width="430" height="62" as="geometry" /></mxCell><mxCell id="e59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d2" target="cat4d2r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="201.0" /><mxPoint x="700.0" y="165.0" /></Array></mxGeometry></mxCell><mxCell id="e60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d2r1" target="cat4d2w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat4d2r2" value="Потеря: значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="206" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat4d2w2" value="Без службы каталогов сотрудники не войдут в системы, работа остановится. Копии есть, простой продлится до восстановления." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="206" width="430" height="62" as="geometry" /></mxCell><mxCell id="e61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d2" target="cat4d2r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="201.0" /><mxPoint x="700.0" y="237.0" /></Array></mxGeometry></mxCell><mxCell id="e62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d2r2" target="cat4d2w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat4d3" value="Ключи и сертификаты интеграций: госорганы, платёжная система, API УК" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="294" width="250" height="62" as="geometry" /></mxCell><mxCell id="e63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4" target="cat4d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="265.0" /><mxPoint x="390.0" y="325.0" /></Array></mxGeometry></mxCell><mxCell id="cat4d3r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="294" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat4d3w1" value="С украденным ключом можно от имени компании отправлять запросы в госорганы и платёжную систему. Последствия юридические и финансовые." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="294" width="430" height="62" as="geometry" /></mxCell><mxCell id="e64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d3" target="cat4d3r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d3r1" target="cat4d3w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat4d4" value="Управление «Умным домом»: привязка и команды запирающих устройств" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="410" width="250" height="62" as="geometry" /></mxCell><mxCell id="e66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4" target="cat4d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390.0" y="265.0" /><mxPoint x="390.0" y="441.0" /></Array></mxGeometry></mxCell><mxCell id="cat4d4r1" value="Утечка: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="382" width="200" height="62" as="geometry" /></mxCell><mxCell id="cat4d4w1" value="Тот, кто получил доступ к управлению замком, может открыть чужую квартиру. Это уже физическая безопасность жильцов." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="382" width="430" height="62" as="geometry" /></mxCell><mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d4" target="cat4d4r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="441.0" /><mxPoint x="700.0" y="413.0" /></Array></mxGeometry></mxCell><mxCell id="e68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d4r1" target="cat4d4w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cat4d4r2" value="Искажение: критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="454" width="200" height="46" as="geometry" /></mxCell><mxCell id="cat4d4w2" value="Если подменить привязку устройства к собственнику, дверь откроется постороннему, а хозяин не попадёт домой." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;rounded=0;align=left;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="990" y="454" width="430" height="46" as="geometry" /></mxCell><mxCell id="e69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d4" target="cat4d4r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700.0" y="441.0" /><mxPoint x="700.0" y="477.0" /></Array></mxGeometry></mxCell><mxCell id="e70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat4d4r2" target="cat4d4w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="Оценка риска" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="-85" y="110" width="170" height="26" as="geometry" /></mxCell><mxCell id="legend0" value="незначительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-85" y="140" width="170" height="28" as="geometry" /></mxCell><mxCell id="legend1" value="значительный" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-85" y="176" width="170" height="28" as="geometry" /></mxCell><mxCell id="legend2" value="критический" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="-85" y="212" width="170" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
